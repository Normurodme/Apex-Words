# Bu FAQAT namuna fayl. Haqiqiy qiymatlarni .env ga yozing (.env git'ga tushmaydi).
# Nusxa olish:  cp .env.example .env

# @BotFather dan olingan bot tokeni
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Mini App (frontend) manzili — Railway frontend servisining URL'i
WEBAPP_URL=https://apex-words-production.up.railway.app

# aiohttp API porti (Railway o'zi PORT beradi)
PORT=8080

# SQLite fayl yo'li. Railway'da Volume /data ga ulanadi.
DB_PATH=data/apex_words.db
